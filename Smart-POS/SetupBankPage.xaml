<Window x:Class="Smart_POS.SetupBankPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:src="clr-namespace:Smart_POS"
        xmlns:con="clr-namespace:Smart_POS.Converters"
        xmlns:vm="clr-namespace:Smart_POS.ViewModels"
        xmlns:vl="clr-namespace:Smart_POS.Validators"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="البنوك" Height="650" Width="1500" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <con:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <vm:SetupBankViewModel x:Key="viewModel"/>
        <vm:SetupBankViewModel x:Key="searchViewModel"/>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Name="myTab">
            <TabItem Header="بيانات البنوك" Width="150">

                <AdornerDecorator>
                    <Grid x:Name="LayoutRoot" DataContext="{Binding Source={StaticResource viewModel}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="رقم البنك" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="26" Text="{Binding Path=Bank.BankAccId, Mode=TwoWay}" Margin="2,2,10,0" VerticalAlignment="Top" Grid.ColumnSpan="5"/>

                        <Label Grid.Row="2" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم الحساب</Label>
                        <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Height="26" ItemsSource="{Binding AccountList}" Margin="2" Width="150"  DisplayMemberPath="name" SelectedValuePath="id"  
                            Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Bank.AccountId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>
                        <Label Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="الحالة" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2,2,0,0"/>
                        <RadioButton Grid.Row="2" Grid.Column="3" VerticalAlignment="Top" Height="26"
                            Name="cashInvoiceBtn" VerticalContentAlignment="Center"
                            Content="فعال" HorizontalAlignment="Left"
             
                            GroupName="Status"
                            IsChecked="{Binding 
                            Path=Bank.Status, 
                            Converter={StaticResource RadioButtonCheckedConverter}, 
                            ConverterParameter=1}" 
                            Margin="5,2,0,0" Width="50"/>
                        <RadioButton Grid.Row="2" Grid.Column="3" VerticalAlignment="Top" Height="26"
                            VerticalContentAlignment="Center"
             
                            GroupName="Status"
                            IsChecked="{Binding 
                            Path=Bank.Status, 
                            Converter={StaticResource RadioButtonCheckedConverter},
                            ConverterParameter=0}" 
                            Content="غير فعال" Margin="53,2,27,0"/>

                        <Label Grid.Row="2" Grid.Column="4" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="لجميع الفروع" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2,2,0,0"/>
                        <RadioButton Grid.Row="2" Grid.Column="5" VerticalAlignment="Top" Height="26"
                            Name="ForAllBranchBtn" VerticalContentAlignment="Center"
                            Content="نعم" HorizontalAlignment="Left"
             
                            GroupName="ForAllB"
                            IsChecked="{Binding 
                            Path=Bank.ForAllBranches, Converter={StaticResource RadioButtonCheckedConverter},
                            ConverterParameter=1}" 
                            Margin="5,2,0,0" Width="50"/>
                        <RadioButton Grid.Row="2" Grid.Column="5" VerticalAlignment="Top" Height="26"
                            VerticalContentAlignment="Center"
             
                            GroupName="ForAllB"
                            IsChecked="{Binding 
                            Path=Bank.ForAllBranches, Converter={StaticResource RadioButtonCheckedConverter},
                            ConverterParameter=0}" 
                            Content="لا" Margin="53,2,27,0"/>

                        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="الاسم بالعربي" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" />
                        <TextBox Grid.Row="3" Grid.Column="1" Height="26" Text="{Binding Path=Bank.AccNameAr, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="1,2,1,0" Width="110" HorizontalContentAlignment="Right">الاسم بالانجليزي</Label>
                        <TextBox Grid.Row="3" Grid.Column="3" Height="26" Text="{Binding Path=Bank.AccNameEn, Mode=TwoWay}" Margin="4,2,1,0" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم الموبايل</Label>
                        <TextBox Grid.Row="4" Grid.Column="1" Height="26" Text="{Binding Path=Bank.MobileNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="4" Grid.Column="2" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم التلفون</Label>
                        <TextBox Grid.Row="4" Grid.Column="3" Height="26" Text="{Binding Path=Bank.TelNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="5" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الدولة</Label>
                        <ComboBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" Height="26" Margin="2" Width="150" DisplayMemberPath="name"
                                  SelectionChanged="CountryCombo_SelectionChanged" Name="CountryCombo" ItemsSource="{Binding CountryList}" SelectedValuePath="id"
                                  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Bank.CountryId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:SelectListValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="5" Grid.Column="2" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">المحافظة</Label>
                        <ComboBox Name="CityCombo" SelectionChanged="CityCombo_SelectionChanged" Grid.Row="5" Grid.Column="3" Height="26"
                                  VerticalAlignment="Top" ItemsSource="{Binding CityList}" Margin="2" Width="150"  DisplayMemberPath="name" 
                                  SelectedValuePath="id" Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Bank.CityId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:SelectListValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="5" Grid.Column="4" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">المديرية</Label>
                        <ComboBox Grid.Row="5" Grid.Column="5" VerticalAlignment="Top" Height="26" ItemsSource="{Binding RegionList}" Margin="2" 
                                  Width="150" DisplayMemberPath="name" SelectedValuePath="id" Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Bank.RegionId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:SelectListValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="6" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">ملاحظات</Label>
                        <TextBox Grid.Row="6" Grid.Column="1" Height="97" Text="{Binding Path=Bank.Note, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top" Grid.ColumnSpan="5" Grid.RowSpan="2"/>

                        <Border Grid.Row="7" Grid.ColumnSpan="9"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            BorderBrush="Gray"
                            Background="LightGray"
                            BorderThickness="2"
                            Margin="5"
                            Padding="8">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Button Command="{Binding NewCommand}" Name="New_Btn" Margin="6" Padding="20,5" Content="جديد" Width="193" Height="52"/>
                                    <Button Command="{Binding SaveCommand}" Name="Save_Btn" Margin="6" Padding="20,5" Content="حفظ" Width="193" Height="52"/>
                                    <Button Command="{Binding FirstCommand}" Name="First_Btn" Margin="6" Padding="20,5" Content="الأول" Width="193" Height="52"/>
                                    <Button Command="{Binding PrevCommand}" Name="Prev_Btn" Margin="6" Padding="20,5" Content="السابق" Width="193" Height="52"/>
                                    <Button Command="{Binding NextCommand}" Name="Next_Btn" Margin="6" Padding="20,5" Content="التالي" Width="193" Height="52"/>
                                    <Button Command="{Binding LastCommand}" Name="Last_Btn" Margin="6" Padding="20,5" Content="الأخير" Width="193" Height="52"/>
                                </StackPanel>

                            </StackPanel>
                        </Border>
                    </Grid>
                </AdornerDecorator>
            </TabItem>
            <TabItem Header="بحث" Width="150">

                <Grid x:Name="searchLayoutRoot" DataContext="{Binding Source={StaticResource searchViewModel}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button  Command="{Binding SearchCommand}" Name="SearchBtn"  Grid.RowSpan="2" Grid.Column="9" HorizontalAlignment="Left" Width="150" Content="بحث" FontSize="18" FontWeight="Bold" Height="45" Margin="10,0,0,10" VerticalAlignment="Bottom" Grid.Row="1" />
                    <ListView MouseDoubleClick="DataList_MouseDoubleClick" Grid.Row="3" Grid.ColumnSpan="10" HorizontalContentAlignment="Stretch" 
                              SelectedIndex="{Binding Path=InvoiceToEditIndex, UpdateSourceTrigger=PropertyChanged}" Name="DataList" Margin="5,5,5,5"
                               ItemsSource="{Binding Path=ListItems}">
                        <ListView.View>
                            <GridView AllowsColumnReorder="true">
                                <GridView.ColumnHeaderContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ascending" />
                                        <MenuItem Header="Descending" />
                                    </ContextMenu>
                                </GridView.ColumnHeaderContextMenu>
                                <GridViewColumn Header="رقم البنك" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BankAccId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالعربي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccNameAr}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم الحساب" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم التلفون" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TelNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم الموبايل" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MobileNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الدولة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CountryId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="المحافظة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CityId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="المنطقة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RegionId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ملاحظات" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="لجميع الفروع" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ForAllBranches}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الحالة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالانجليزي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccNameEn}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
