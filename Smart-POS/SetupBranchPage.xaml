<Window x:Class="Smart_POS.SetupBranchPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:src="clr-namespace:Smart_POS"
        xmlns:con="clr-namespace:Smart_POS.Converters"
        xmlns:vm="clr-namespace:Smart_POS.ViewModels"
        xmlns:vl="clr-namespace:Smart_POS.Validators"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="الفروع" Height="650" Width="1500" 
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <con:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <vm:SetupBranchViewModel x:Key="viewModel"/>
        <vm:SetupBranchViewModel x:Key="searchViewModel"/>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Name="myTab">
            <TabItem Header="بيانات الفروع" Width="150">

                <AdornerDecorator>
                    <Grid x:Name="LayoutRoot" DataContext="{Binding Source={StaticResource viewModel}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="رقم الفرع" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="26" Margin="2" Width="150" VerticalAlignment="Top" Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="Branch.BranchId" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <Label Grid.Row="1" Grid.Column="2" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="الاسم بالعربي" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" />
                        <TextBox Grid.Row="1" Grid.Column="3" Height="26" Margin="2" Width="150" 
                                 VerticalAlignment="Top" Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="Branch.NameAr" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:RequiredTextValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>

                        <Label Grid.Row="1" Grid.Column="4" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="1,2,1,0" Width="110" HorizontalContentAlignment="Right">الاسم بالانجليزي</Label>
                        <TextBox Grid.Row="1" Grid.Column="5" Height="26" Text="{Binding Path=Branch.NameEn, Mode=TwoWay}" Margin="4,2,1,0" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم السجل التجاري</Label>
                        <TextBox Grid.Row="2" Grid.Column="1" Height="26" Text="{Binding Path=Branch.ComercialRecNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الرقم الضريبي</Label>
                        <TextBox Grid.Row="2" Grid.Column="3" Height="26" Text="{Binding Path=Branch.TaxNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم الموبايل</Label>
                        <TextBox Grid.Row="3" Grid.Column="1" Height="26" Text="{Binding Path=Branch.MobileNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="3" Grid.Column="2" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الايميل</Label>
                        <TextBox Grid.Row="3" Grid.Column="3" Height="26" Text="{Binding Path=Branch.Email, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم الثابت</Label>
                        <TextBox Grid.Row="4" Grid.Column="1" Height="26" Text="{Binding Path=Branch.TelNo, Mode=TwoWay}" Margin="2" Width="150" VerticalAlignment="Top"/>

                        <Label Grid.Row="4" Grid.Column="2" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم الفاكس</Label>
                        <TextBox Grid.Row="4" Grid.Column="3" Height="26" Text="{Binding Path=Branch.Fax, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top" />

                        <Label Grid.Row="5" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الدولة</Label>
                        <ComboBox Grid.Row="5" Grid.Column="1" SelectionChanged="CountryCombo_SelectionChanged" Name="CountryCombo" VerticalAlignment="Top" Height="26" ItemsSource="{Binding CountryList}" Margin="2" Width="150"  DisplayMemberPath="name" SelectedValuePath="id"
                                  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Branch.CountryId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:RequiredTextValidator/>
                                    </Binding.ValidationRules>

                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="5" Grid.Column="2" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">المحافظة</Label>
                        <ComboBox Grid.Row="5" Grid.Column="3" Name="CityCombo" SelectionChanged="CityCombo_SelectionChanged" VerticalAlignment="Top" Height="26" ItemsSource="{Binding CityList}" Margin="2" Width="150"  DisplayMemberPath="name" SelectedValuePath="id"  
                                Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Branch.CityId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:RequiredTextValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="5" Grid.Column="4" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">المديرية</Label>
                        <ComboBox Grid.Row="5" Grid.Column="5" VerticalAlignment="Top" Height="26" ItemsSource="{Binding RegionList}" Margin="2" Width="150"  DisplayMemberPath="name" SelectedValuePath="id"
                            Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Branch.RegionId"  Mode="TwoWay" ValidatesOnExceptions="True" 
                                    ValidatesOnDataErrors="True" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                    <Binding.ValidationRules>
                                        <vl:RequiredTextValidator/>
                                    </Binding.ValidationRules>
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="6" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الشارع</Label>
                        <TextBox Grid.Row="6" Grid.Column="1" Height="26" Text="{Binding Path=Branch.Sreet, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top" Grid.ColumnSpan="5"/>

                        <Label Grid.Row="7" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">الرمز البريدي</Label>
                        <TextBox Grid.Row="7" Grid.Column="1" Height="26" Text="{Binding Path=Branch.PostCode, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top"/>

                        <Label Grid.Row="7" Grid.Column="2" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">رقم المبنى</Label>
                        <TextBox Grid.Row="7" Grid.Column="3" Height="26" Text="{Binding Path=Branch.BuildingNo, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top"/>

                        <Label Grid.Row="8" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2" Width="110" HorizontalContentAlignment="Right">ملاحظات</Label>
                        <TextBox Grid.Row="8" Grid.Column="1" Height="97" Text="{Binding Path=Branch.Note, Mode=TwoWay}" Margin="2,2,0,0" VerticalAlignment="Top" Grid.ColumnSpan="5" Grid.RowSpan="2"/>

                        <Border Grid.Row="9" Grid.ColumnSpan="9"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            BorderBrush="Gray"
                            Background="LightGray"
                            BorderThickness="2"
                            Margin="5"
                            Padding="8">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal"  Margin="2">
                                    <Button Command="{Binding NewCommand}" Name="New_Btn" Margin="6" Padding="20,5" Content="جديد" Width="193" Height="52"/>
                                    <Button Command="{Binding SaveCommand}" Name="Save_Btn" Margin="6" Padding="20,5" Content="حفظ" Width="193" Height="52"/>
                                    <Button Command="{Binding FirstCommand}" Name="First_Btn" Margin="6" Padding="20,5" Content="الأول" Width="193" Height="52"/>
                                    <Button Command="{Binding PrevCommand}" Name="Prev_Btn" Margin="6" Padding="20,5" Content="السابق" Width="193" Height="52"/>
                                    <Button Command="{Binding NextCommand}" Name="Next_Btn" Margin="6" Padding="20,5" Content="التالي" Width="193" Height="52"/>
                                    <Button Command="{Binding LastCommand}" Name="Last_Btn" Margin="6" Padding="20,5" Content="الأخير" Width="193" Height="52"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </AdornerDecorator>
            </TabItem>
            <TabItem Header="بحث" Width="150">

                <Grid x:Name="searchLayoutRoot" DataContext="{Binding Source={StaticResource searchViewModel}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding SearchCommand}" Name="SearchBtn"  Grid.RowSpan="3" Grid.Column="8" HorizontalAlignment="Left" Width="150" Content="بحث" FontSize="18" FontWeight="Bold" Height="45" Margin="10" VerticalAlignment="Bottom"/>
                    <ListView MouseDoubleClick="DataList_MouseDoubleClick" SelectedIndex="{Binding Path=InvoiceToEditIndex, 
                        UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Grid.ColumnSpan="16" 
                              ItemsSource="{Binding Path=ListItems}" Name="DataList"
                              HorizontalContentAlignment="Stretch" Margin="5,5,5,5">
                        <ListView.View>
                            <GridView AllowsColumnReorder="true">
                                <GridView.ColumnHeaderContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ascending" />
                                        <MenuItem Header="Descending" />
                                    </ContextMenu>
                                </GridView.ColumnHeaderContextMenu>
                                <GridViewColumn Header="رقم الفرع" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BranchId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالعربي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NameAr}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالانجليزي" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NameEn}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم التلفون" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TelNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم الموبايل" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MobileNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الفاكس" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Fax}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الايميل" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Email}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="السجل التجاري" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ComercialRecNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الرقم الضريبي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TaxNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الدولة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CountryId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="المحافظة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CityId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="المنظفة" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RegionId}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="رقم المبنى" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding BuildingNo}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الشارع" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Sreet}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الرمز البريدي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PostCode}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="ملاحظات" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Note}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
