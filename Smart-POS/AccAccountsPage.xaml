<Window x:Class="Smart_POS.AccAccountsPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:src="clr-namespace:Smart_POS"
        xmlns:con="clr-namespace:Smart_POS.Converters"
        xmlns:vm="clr-namespace:Smart_POS.ViewModels"
        xmlns:vl="clr-namespace:Smart_POS.Validators"
        mc:Ignorable="d"
        FlowDirection="RightToLeft"
        Title="الدليل المحاسبي" Height="650" Width="1500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Window.Resources>
        <con:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter"/>
        <vm:AccAccountsViewModel x:Key="viewModel"/>
        <vm:AccAccountsViewModel x:Key="searchViewModel"/>
        <Style TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>
    <Grid>
        <TabControl Name="myTab">
            <TabItem Header="بيانات الدليل المحاسبي" Width="150">

                <AdornerDecorator>
                    <Grid x:Name="LayoutRoot" DataContext="{Binding Source={StaticResource viewModel}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="10" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="155"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="رقم الحساب" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2,2,0,0" Width="110" />
                        <TextBox Grid.Row="1" Grid.Column="1" Height="26" Text="{Binding Path=Account.AccountId, Mode=TwoWay}" Margin="2,2,3,0" Width="150" VerticalAlignment="Top" IsReadOnly="True" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="2" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2,2,0,0" Width="110" HorizontalContentAlignment="Right">الحساب الاب</Label>
                        <ComboBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Height="26" ItemsSource="{Binding AccountList}" Margin="2,2,3,0" Width="150" DisplayMemberPath="name" SelectedValuePath="id"  
                                Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" Grid.ColumnSpan="2" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Account.AccountParent" Mode="TwoWay" ValidatesOnExceptions="True" 
                                    NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="1,2,1,0" Width="110" HorizontalContentAlignment="Right">الاسم بالعربي</Label>
                        <TextBox Grid.Row="3" Grid.Column="1" Height="26" Text="{Binding Path=Account.AccountNameAr, Mode=TwoWay}" Margin="2,2,3,0" Width="150" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="4" Grid.Column="0" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Height="26" Margin="1,2,1,0" Width="110" HorizontalContentAlignment="Right">الاسم بالانجليزي</Label>
                        <TextBox Grid.Row="4" Grid.Column="1" Height="26" Text="{Binding Path=Account.AccountNameEn, Mode=TwoWay}" Margin="2,2,3,0" Width="150" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

                        <Label Grid.Row="5" Grid.Column="0" FontSize="12" VerticalAlignment="Top" FontWeight="SemiBold" Height="26" Margin="2,2,0,0" Width="110" HorizontalContentAlignment="Right">نوع الحساب</Label>
                        <ComboBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Top" Height="26" ItemsSource="{Binding AccountList}" Margin="2,2,3,0" Width="150" DisplayMemberPath="name" SelectedValuePath="id"  
                                Validation.ErrorTemplate="{StaticResource validationErrorTemplate}" Grid.ColumnSpan="2" >
                            <ComboBox.SelectedValue>
                                <Binding Path="Account.AccountType" Mode="TwoWay" ValidatesOnExceptions="True" 
                                    NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                                </Binding>
                            </ComboBox.SelectedValue>
                        </ComboBox>

                        <Label Grid.Row="5" Grid.Column="3" VerticalAlignment="Top" HorizontalContentAlignment="Right" Content="طبيعة الحساب" FontSize="12" FontWeight="SemiBold" Height="26" Margin="2,2,0,0"/>
                        <RadioButton Grid.Row="5" Grid.Column="4" VerticalAlignment="Top" Height="26" Margin="5,2,0,0" VerticalContentAlignment="Center"
                                     Name="cashInvoiceBtn" Content="مدين" HorizontalAlignment="Left" Width="72"
                            GroupName="AccNature"
                            IsChecked="{Binding 
                            Path=Account.AccountNature,
                            Converter={StaticResource RadioButtonCheckedConverter},
                            ConverterParameter=1}"/>
                        <RadioButton Grid.Row="5" Grid.Column="4" VerticalAlignment="Top" Height="26" Margin="77,2,0,0" VerticalContentAlignment="Center" 
                                     Content="دائن" 
                            GroupName="AccNature"
                            IsChecked="{Binding 
                            Path=Account.AccountNature, 
                            Converter={StaticResource RadioButtonCheckedConverter}, 
                            ConverterParameter=2}"/>

                        <CheckBox Grid.Row="5" Grid.Column="5" Content="الحساب فرعي" VerticalAlignment="Top" Height="26" VerticalContentAlignment="Center">
                        </CheckBox>

                        <Border Grid.Row="6" Grid.ColumnSpan="10"
                            VerticalAlignment="Bottom" CornerRadius="2" BorderBrush="Gray" Background="LightGray" BorderThickness="2" Margin="5,0,5,5" Padding="8">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Button Command="{Binding NewCommand}" Name="New_Btn" Margin="6" Padding="20,5" Content="جديد" Width="193" Height="52"/>
                                    <Button Command="{Binding SaveCommand}" Name="Save_Btn" Margin="6" Padding="20,5" Content="حفظ" Width="193" Height="52"/>
                                    <Button Command="{Binding FirstCommand}" Name="First_Btn" Margin="6" Padding="20,5" Content="الأول" Width="193" Height="52"/>
                                    <Button Command="{Binding PrevCommand}" Name="Prev_Btn" Margin="6" Padding="20,5" Content="السابق" Width="193" Height="52"/>
                                    <Button Command="{Binding NextCommand}" Name="Next_Btn" Margin="6" Padding="20,5" Content="التالي" Width="193" Height="52"/>
                                    <Button Command="{Binding LastCommand}" Name="Last_Btn" Margin="6" Padding="20,5" Content="الأخير" Width="193" Height="52"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </AdornerDecorator>
            </TabItem>
            <TabItem Header="بحث" Width="150">

                <Grid x:Name="searchLayoutRoot" DataContext="{Binding Source={StaticResource searchViewModel}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" MinHeight="150" />
                        <RowDefinition Height="5" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="155"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="115"/>
                        <ColumnDefinition Width="112"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Command="{Binding SearchCommand}" Name="SearchBtn" Grid.RowSpan="3" Grid.Column="8" HorizontalAlignment="Left" Width="150" Content="بحث" FontSize="18" FontWeight="Bold" Height="45" Margin="10"/>
                    <ListView MouseDoubleClick="DataList_MouseDoubleClick" Grid.Row="3" Grid.ColumnSpan="9" Margin="5,5"
                              SelectedIndex="{Binding Path=InvoiceToEditIndex, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Path=ListItems}" Name="DataList" HorizontalContentAlignment="Stretch">
                        <ListView.View>
                            <GridView AllowsColumnReorder="true">
                                <GridView.ColumnHeaderContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Ascending" />
                                        <MenuItem Header="Descending" />
                                    </ContextMenu>
                                </GridView.ColumnHeaderContextMenu>
                                <GridViewColumn Header="رقم الحساب" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountId}" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالعربي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountNameAr}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="طبيعة الحساب" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountNature}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="نوع الحساب" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountType}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الحساب الاب" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountParent}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="هل الحساب فرعي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SubAccount}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="مستوى الحساب" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountLevel}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="التاريخ" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccDate}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="الاسم بالانجليزي" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding AccountNameEn}" TextAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
